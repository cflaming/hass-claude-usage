# Default: text files are normalized to LF in the repo and checked out as LF
* text=auto eol=lf

# Windows-only scripts may need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix scripts must be LF
*.sh text eol=lf
*.bash text eol=lf

# Common text/config files
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
LICENSE text eol=lf
TODO text eol=lf
.gitignore text eol=lf

# Binary files: never line-ending convert
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.exe binary
*.dll binary
